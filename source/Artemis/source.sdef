c ------------------------------------------------------------------------------
c     Source definition for Artemis, made by beam-target
c     Case summary (TOML; the same as summary.toml written by write_text_files):
c ------------------------------------------------------------------------------
c
c [run]
c name                    = "Artemis"
c code_version            = "6113b4de3492cfcf55e46f62f4e5a9deee628722"
c created                 = "2026-11-20T21:08:56+00:00"
c input_file              = "source/artemis.toml"
c sdef_direction          = "-z"
c sdef_entry_position     = [0.0, 0.0, 137.0]
c sdef_backstop_position  = [0.0, 0.0, 0.0]
c
c [inputs]
c beam                    = "deuteron"       # beam particle
c beam_energy_entry       = 280.0            # keV
c beam_current            = 45.0             # mA
c region                  = ["chamber"]      # per region: names (if any)
c material                = ["DT50"]         # per region; see [materials]
c pressure                = [nan]            # torr; nan where unused
c temperature             = [nan]            # degC; nan where unused
c density                 = [1.496722e-06]   # g/cm3, calculated for region 1; nan where unused
c length                  = [137.0]          # cm
c beam_energy_backstop    = 10.0             # keV, requested
c beam_radius_entry       = 0.2              # cm
c wall_radius             = [5.4483]         # cm
c divergence              = [36.0]           # mrad
c position_bins           = [137]
c position_substeps       = [10]             # per position bin
c angle_bin_width         = 1.0              # deg
c energy_bin_width        = 0.01             # MeV
c stopping_power          = "srim"
c nuclear_data            = ["drosg"]        # libraries, searched in order
c nuclear_data_dirs       = ["drosg"]        # where they were found
c
c [results]
c yield_total             = 1.77562e+13      # n/s
c yield_DD                = 1.701041e+11     # n/s, D(d,n)3He
c yield_DT                = 1.75861e+13      # n/s, T(d,n)4He
c fraction_DD             = 0.00957998       # share of the total yield
c fraction_DT             = 0.99042          # share of the total yield
c mean_neutron_energy     = 14.00315         # MeV, all reactions and angles
c mean_neutron_energy_DD  = 2.547529         # MeV, over all angles
c mean_neutron_energy_DT  = 14.11395         # MeV, over all angles
c atom_density            = [3.583778e+17]   # atoms/cm3, in each region
c beam_energy_region_end  = [10.0]           # keV, at the end of each region
c beam_energy_backstop    = 10.0             # keV
c beam_radius_backstop    = 5.132            # cm, beam edge; capped at the wall
c beam_current_backstop   = 45.0             # mA, after scraping and nuclear losses
c beam_power_entry        = 12.6             # kW
c beam_power_deposited    = 12.15            # kW, deposited in the target material (gas or solid)
c beam_power_wall         = 0.0              # kW, carried onto the wall by scraping
c beam_power_backstop     = 0.45             # kW
c beam_power_nuclear      = 0.0              # kW, of the deposited power: beam lost to nuclear reactions
c beam_nuclear_loss       = 0.0              # fraction of the beam removed by nuclear reactions
c neutron_scrape_fraction = 2.199174e-16     # neutrons lost to scraping
c
c [materials.DT50]
c phase                   = "gas"
c molecules               = { D2 = 0.5, T2 = 0.5 }
c
c [reactions.DD]
c reaction                = "D(d,n)3He"
c data                    = "DROSG-2000 v12.01, d2hags.koe"
c
c [reactions.DT]
c reaction                = "T(d,n)4He"
c data                    = "DROSG-2000 v12.01, d3hags.koe"
c
c ------------------------------------------------------------------------------
c
c     Using this source:
c     - Tallies are per source neutron: multiply them by yield_total
c       (1.775620e+13 n/s) for absolute rates.
c     - The beam enters at (0 0 137) cm, travels along -z and
c       reaches the backstop at (0 0 0) cm, 137 cm further on.
c       This -z card runs along +z, so POS is the backstop end.
c     - Neutron energy depends on emission angle but not on position along the
c       beam: the drop in neutron energy as the beam slows is averaged out.
c       This is a limitation of MCNP: an SDEF distribution can depend on only
c       one other variable, so energy depends on direction (ERG = FDIR) and
c       cannot also depend on position along the beam.
c     - The angular distribution is also averaged over position along the
c       beam, again because of MCNP: making direction depend on position
c       (DIR = FEXT) is not accepted together with ERG = FDIR.
c
c ------------------------------------------------------------------------------
c
  sdef  par = n
        pos = 0 0 0
        axs = 0 0 1
        vec = 0 0 -1
        ext = d1
        dir = d2
        rad = fext = d3
        erg = fdir = d4
c
c ------------------------------------------------------------------------------
